# Copy to extension/.env and fill in after deploying the relay.
#
#   cd relay && npx wrangler deploy      -> gives you the workers.dev URL
#   npx web-push generate-vapid-keys     -> gives you the keypair
#
# The PRIVATE key never appears here; it goes to the relay as a secret:
#   npx wrangler secret put VAPID_PRIVATE_KEY

WXT_RELAY_URL=https://otp-bridge-relay.your-subdomain.workers.dev
WXT_VAPID_PUBLIC_KEY=
